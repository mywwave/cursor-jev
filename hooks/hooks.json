{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node ./bin/cli.mjs hook",
        "matcher": "Task|Write|StrReplace|Delete|Read|Shell|MCP:.*",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node ./bin/cli.mjs hook",
        "matcher": "Task|Grep|Glob|SemanticSearch|MCP:codegraph_explore",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./bin/cli.mjs hook",
        "matcher": "UserPromptSubmit",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./bin/cli.mjs hook",
        "timeout": 5
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node ./bin/cli.mjs hook",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "node ./bin/cli.mjs hook",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "node ./bin/cli.mjs hook",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node ./bin/cli.mjs hook",
        "timeout": 5
      }
    ]
  }
}
